{
  "$schema": "https://hcli.docs.hex-rays.com/schemas/ida-plugin.json",
  "IDAMetadataDescriptorVersion": 1,
  "plugin": {
    "name": "ida-ttd",
    "entryPoint": "ida-ttd",
    "components": [
      "ida-ttd-loader-setup"
    ],
    "version": "1.0.0",
    "description": "Replay Microsoft Time Travel Debugging (.run) and Sogen (.sogttd) recordings as an IDA debugger session: step forwards and backwards, and query the whole recording for calls, coverage, memory accesses, syscalls and strings.",
    "license": "Apache-2.0",
    "platforms": [
      "windows-x86_64"
    ],
    "idaVersions": [
      "9.4"
    ],
    "categories": [
      "debugging-and-tracing",
      "malware-analysis",
      "file-parsers-and-loaders"
    ],
    "keywords": [
      "ttd",
      "time travel debugging",
      "windbg",
      "trace",
      "reverse debugging",
      "shellcode",
      "unpacking"
    ],
    "urls": {
      "repository": "https://github.com/HullaBrian/ida-ttd"
    },
    "authors": [
      {
        "name": "HullaBrian",
        "email": "git@beierle.win"
      }
    ]
  }
}
