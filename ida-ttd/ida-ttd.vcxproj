  <PropertyGroup>
    <TargetName>ida-ttd</TargetName>
    <!-- Repo root, resolved from this project file rather than $(SolutionDir):
         MSBuild only defines SolutionDir when a solution drives the build, so
         building ida-ttd.vcxproj directly would otherwise point these at the
         project directory instead of the repo root. -->
    <RepoRoot>$(MSBuildThisFileDirectory)..\</RepoRoot>
    <IdaSdkDir>$(RepoRoot)ida-sdk\src</IdaSdkDir>
    <!-- Pinned for the same reason: the default IntDir varies depending on
         whether the solution or the project drives the build. -->
    <IntDir>$(MSBuildThisFileDirectory)$(Platform)\$(Configuration)\</IntDir>
