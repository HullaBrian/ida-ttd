  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <!-- NDEBUG, not _DEBUG: this config keeps the RELEASE CRT (see RuntimeLibrary
           below) because that is what IDA itself uses. _DEBUG would make the MSVC
           headers reference debug-CRT-only symbols (_CrtDbgReport, _calloc_dbg,
           msvcprtd.lib) that the release CRT does not export -> LNK2001/LNK1120.
           This is an unoptimised build with full debug info, not a debug-CRT build. -->
      <PreprocessorDefinitions>NDEBUG;__NT__;__EA64__;__X64__;_CRT_SECURE_NO_WARNINGS;_SILENCE_ALL_CXX20_DEPRECATION_WARNINGS;WIN32;_WINDOWS;_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <AdditionalIncludeDirectories>$(IdaSdkDir)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- Match IDA's CRT: use the dynamic release runtime even in Debug. -->
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableUAC>false</EnableUAC>
      <AdditionalLibraryDirectories>$(IdaSdkDir)\lib\x64_win_64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>ida.lib;TTDReplay.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
